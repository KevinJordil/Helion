<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only used for the custom-server export, see
         ch.kevinjordil.helion.customserver.HttpCustomServerApi. Nothing else in Helion
         talks to the network; the Strava paths (Downloads save, opening the web uploader)
         need no network access of their own. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Only needed on Android 8.0/8.1 (API 26 to 28): that is before MediaStore's Downloads
      collection existed, so the "save TCX to Downloads" action has no scoped storage route
      on those versions and must write a plain file into the public Downloads directory
      instead, see ch.kevinjordil.helion.export.saveTcxToDownloads. maxSdkVersion means
      this permission is simply never requested, and never shows in the Play Store listing,
      on API 29+, where the MediaStore route needs no permission at all.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!--
      Runtime permission from Android 13 (API 33) onward, a no-op declaration below that,
      where posting a notification never required asking. Requested from Réglages, not at
      first launch, see ch.kevinjordil.helion.ui.settings.SettingsScreen's notifications
      section, and a refusal is handled everywhere as "post nothing", never as a crash or
      a broken ingest pass (see ch.kevinjordil.helion.notification.CandidateNotifier).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (API 30+), kept for whatever future need to resolve the Strava
      app or a market:// listing. ch.kevinjordil.helion.export.buildOpenStravaIntent
      itself opens Strava's web uploader directly and needs neither.
    -->
    <queries>
        <package android:name="com.strava" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:name=".HelionApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager's default androidx.startup initializer is removed here because
          HelionApp implements Configuration.Provider: WorkManager then initialises
          on demand, on the first WorkManager.getInstance() call (see SyncScheduler),
          instead of eagerly on process start with a default Configuration it would
          otherwise discard in favour of ours.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
