<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".HelionApp"
        android:label="@string/app_name"
        android:allowBackup="true">

        <!--
          WorkManager's default androidx.startup initializer is removed here because
          HelionApp implements Configuration.Provider: WorkManager then initialises
          on demand, on the first WorkManager.getInstance() call (see SyncScheduler),
          instead of eagerly on process start with a default Configuration it would
          otherwise discard in favour of ours.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
